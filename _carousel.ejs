```{=html}
<div id="smt-viz" class="carousel slide smt-carousel" data-bs-interval="false">
  <div class="carousel-inner">
  <% items.forEach((item, i) => { %>
    <div class="carousel-item<%= i === 0 ? ' active' : '' %>" <%= metadataAttrs(item) %>>
      <figure class="smt-slide">
        <div class="smt-slide-frame smt-glow">
          <img src="<%- item.image %>" alt="<%= item.title %>"<%= i === 0 ? '' : ' loading="lazy"' %>>
        </div>
        <figcaption class="smt-slide-caption">
          <span class="smt-small smt-muted"><%= item.date %></span>
          <span class="smt-slide-title"><%= item.title %></span>
          <% if (item.description) { %>
          <span class="smt-muted"><%= item.description %></span>
          <% } %>
          <a class="smt-link" href="<%- item.code %>">View code <i class="bi bi-arrow-right"></i></a>
        </figcaption>
      </figure>
    </div>
  <% }) %>
  </div>
  <button class="carousel-control-prev smt-carousel-btn" type="button" data-bs-target="#smt-viz" data-bs-slide="prev">
    <i class="bi bi-chevron-left"></i><span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next smt-carousel-btn" type="button" data-bs-target="#smt-viz" data-bs-slide="next">
    <i class="bi bi-chevron-right"></i><span class="visually-hidden">Next</span>
  </button>
  <div class="carousel-indicators">
  <% items.forEach((item, i) => { %>
    <button type="button" data-bs-target="#smt-viz" data-bs-slide-to="<%= i %>"<%= i === 0 ? ' class="active" aria-current="true"' : '' %> aria-label="<%= item.title %>"></button>
  <% }) %>
  </div>
</div>
```
